dist/
node_modules/
*.log
local-test-reports/
# Built game files (~80 MB) are GitHub Release assets, never git commits: main releases and
# BUILD-RELEASE.cmd's branch/timestamped builds (e.g. ShambConkins_v0.60.0_TestVer.html).
releases/*.html
# ...and the installable-app folders/zips made next to them (tools/build.mjs --pwa)
releases/*_pwa/
releases/*_app/
releases/*_app_built-*/
releases/*.zip
# The owner's own Doom IWADs (DOOM.WAD / DOOM2.WAD): copyrighted, never commit them. See src/engines/doom/README.md.
assets/doom/user/

# zipped copy of docs/pinball-art templates (the PNGs themselves are tracked)
docs/pinball-art/*.zip

# wrangler dev's local state and build output (cloudflare/)
.wrangler/
# the app's pictures/sounds the Worker serves, filled before a deploy by tools/worker-assets.sh
cloudflare/public/a/

# Claude Code agent worktrees (temporary checkouts)
.claude/worktrees/

# soak test (tools/soak.mjs) output stays on the machine that ran it; share soak-reports/LATEST.md (+ fails/) by uploading it
soak-reports/
